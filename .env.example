# Copy to .env and fill in. Never commit .env.
# Every variable below is read by src/lib/config.js (or the scripts noted).
# Empty values fall back to the defaults shown in the comments.

# --- PostgreSQL 16 ---------------------------------------------------------
# Database host (default 127.0.0.1)
PGHOST=127.0.0.1
# Database port (default 5432)
PGPORT=5432
# Database name (default btc_research; the shell scripts assume this name)
PGDATABASE=btc_research
# Database role that owns the research schema
PGUSER=btc
# Password for PGUSER (leave blank for local trust auth)
PGPASSWORD=changeme

# --- Kalshi ----------------------------------------------------------------
# API key ID (UUID from kalshi.com -> Account -> API keys); needed only by the websocket collector
KALSHI_API_KEY_ID=
# Absolute path to the RSA private key PEM for that key; keep it OUTSIDE this repo, chmod 600
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-private-key.pem
# API environment: prod or demo (default prod)
KALSHI_ENV=prod
# Comma-separated series to collect/backfill (default KXBTC15M,KXBTC); other 15-min series such as KXETH15M or KXGOLD15M also work
KALSHI_SERIES=KXBTC15M,KXBTC
# Days of history the Kalshi backfill requests (default 90; the live API holds roughly 3 months)
BACKFILL_DAYS=90

# --- Pyth ------------------------------------------------------------------
# Pyth Hermes/Benchmarks bearer key for the live commodity/crypto proxy feeds (optional; blank disables those feeds)
PYTH_API_KEY=

# --- Notifications ---------------------------------------------------------
# ntfy.sh topic for phone alerts (monitor, status-ping, retention, recovery scripts); treat it like a secret; blank disables
NTFY_TOPIC=

# --- Live dislocation monitor ---------------------------------------------
# Minimum |fair - mid| gap, in dollars of probability, before an event opens (default 0.03)
DISLOC_MIN_GAP=
# Consecutive seconds the gap must persist before an event opens (default 3)
DISLOC_MIN_RUN_S=
# Minimum seconds between phone alerts (default 60)
DISLOC_ALERT_COOLDOWN_S=

# --- Kalshi collector tuning ----------------------------------------------
# Book snapshot cadence in ms (default 1000)
SNAPSHOT_INTERVAL_MS=
# Force a snapshot row at least this often in ms, for liveness (default 30000)
FORCE_SNAPSHOT_EVERY_MS=
# How often to poll for newly opened markets, in ms (default 30000)
DISCOVERY_INTERVAL_MS=

# --- Live board (src/report/live-board.js) --------------------------------
# HTTP port for the live research board (default 8791)
LIVE_BOARD_PORT=
# Bind address (default 127.0.0.1; set 0.0.0.0 only on a trusted network, the board has no auth)
LIVE_BOARD_HOST=

# --- Shell scripts ---------------------------------------------------------
# Directory holding a globally installed pm2, used by scripts/recover-after-reboot.sh (default $HOME/.npm-global/bin)
NPM_GLOBAL_BIN=
